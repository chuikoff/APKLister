#include <winver.h>
#include "version.h"
VS_VERSION_INFO VERSIONINFO
FILEVERSION APKL_VER_MAJOR,APKL_VER_MINOR,APKL_VER_PATCH,0
PRODUCTVERSION APKL_VER_MAJOR,APKL_VER_MINOR,APKL_VER_PATCH,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "chuikoff"
            VALUE "FileDescription", "APK Lister - Total Commander Lister plugin for Android packages"
            VALUE "FileVersion", APKL_VER_STR
            VALUE "InternalName", "apklister"
            VALUE "LegalCopyright", "(c) 2026 chuikoff, GPL-2.0-or-later"
            VALUE "OriginalFilename", "apklister.wlx"
            VALUE "ProductName", "APK Lister"
            VALUE "ProductVersion", APKL_VER_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
